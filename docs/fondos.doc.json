      "fondo": "I+d+i",
      "year_var": "FONDOS_YEAR_IDI",
      "silver_table": "dt_cepra_data",
      "dest_fqn": "TIC CMI DB.CMI.cedia-ps.dt_cepra_data"
    },
    {
      "dag": "7_4_fondo_1a1",
      "fondo": "1 A 1",
      "year_var": "FONDOS_YEAR_1A1",
      "silver_table": "dt_fondo_1a1",
      "dest_fqn": "TIC CMI DB.CMI.cedia-ps.dt_fondo_1a1"
    },
    {
      "dag": "7_5_fondo_registra",
      "fondo": "Registra",
      "year_var": "FONDOS_YEAR_REGISTRA",
      "silver_table": "dt_fondo_registra",
      "dest_fqn": "TIC CMI DB.CMI.cedia-ps.dt_fondo_registra"
    },
    {
      "dag": "7_fondo_ponente",
      "fondo": "Ponente",
      "year_var": "FONDOS_YEAR_PONENTE",
